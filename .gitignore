# Track only source, required assets, build/release configuration and essential docs.
/*
!/.gitignore
!/.clang-format
!/README.md
!/THIRD_PARTY_NOTICES.md
!/CMakeLists.txt
!/CMakePresets.json
!/.github/
!/.github/**
!/src/
!/src/**
!/assets/
!/assets/**
!/tests/
!/tests/**

!/third_party/
/third_party/*
!/third_party/dr_wav.h
!/third_party/miniaudio.h
!/third_party/VERSIONS.txt
!/third_party/LLVM-MINGW-LICENSE.txt

!/docs/
/docs/*
!/docs/KEY_NAMES.md

!/tools/
/tools/*
!/tools/build-portable.ps1
!/tools/package-release.ps1
!/tools/fetch-toolchain.py
!/tools/LatencyCapture.cpp
!/tools/analyze_timings.py
!/tools/compare_latency.py

# Generated data and local IDE/build files, including inside source directories.
**/__pycache__/
*.pyc
*.exe
*.dll
*.obj
*.pdb
*.ilk
*.log
*.csv
*.f32
*.user
*.suo
**/.vs/
