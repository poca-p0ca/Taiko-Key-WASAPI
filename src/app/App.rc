#include <windows.h>
1 RT_MANIFEST "app.manifest"
101 BITMAP "../image/Background.bmp"
102 MENU
BEGIN
    MENUITEM "&Settings", 110
END
1 VERSIONINFO
 FILEVERSION 0,2,4,0
 PRODUCTVERSION 0,2,4,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Taiko Key WASAPI"
   VALUE "FileVersion", "0.2.4"
   VALUE "ProductName", "Taiko Key WASAPI"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
