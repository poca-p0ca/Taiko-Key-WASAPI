#include <windows.h>
#include <commctrl.h>
#include "resource.h"
1 RT_MANIFEST "app.manifest"
101 BITMAP "../image/Background.bmp"
102 MENU
BEGIN
    MENUITEM "&Settings", 110
END
1 VERSIONINFO
 FILEVERSION 0,2,5,0
 PRODUCTVERSION 0,2,5,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Taiko Key WASAPI"
   VALUE "FileVersion", "0.2.5"
   VALUE "ProductName", "Taiko Key WASAPI"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

IDD_KEYBINDS DIALOGEX 0, 0, 252, 226
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Keybinds"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Sounds", IDC_SOUND_GROUP, 7, 4, 238, 86
    CONTROL         "", IDC_SOUNDS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 14, 16, 170, 66
    PUSHBUTTON      "Add...", IDC_SOUND_ADD, 190, 16, 48, 14
    PUSHBUTTON      "Replace...", IDC_SOUND_REPLACE, 190, 32, 48, 14
    PUSHBUTTON      "Remove", IDC_SOUND_REMOVE, 190, 48, 48, 14
    PUSHBUTTON      "Play", IDC_SOUND_PLAY, 190, 64, 48, 14
    GROUPBOX        "Keys", IDC_KEY_GROUP, 7, 94, 238, 104
    CONTROL         "", IDC_KEYS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 14, 106, 170, 86
    PUSHBUTTON      "Add...", IDC_KEY_ADD, 190, 106, 48, 14
    PUSHBUTTON      "Change...", IDC_KEY_EDIT, 190, 122, 48, 14
    PUSHBUTTON      "Remove", IDC_KEY_REMOVE, 190, 138, 48, 14
    DEFPUSHBUTTON   "OK", IDOK, 88, 206, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 142, 206, 50, 14
    PUSHBUTTON      "Apply", IDC_APPLY, 196, 206, 50, 14
END

IDD_KEYCAPTURE DIALOGEX 0, 0, 190, 91
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Assign Key"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Key:", IDC_CAPTURE_KEY_LABEL, 7, 10, 36, 8
    CONTROL         "", IDC_CAPTURE, "TaikoKeyCaptureBox", WS_TABSTOP, 46, 6, 137, 16, WS_EX_CLIENTEDGE
    LTEXT           "", IDC_CAPTURE_NOTE, 46, 25, 137, 16
    LTEXT           "Sound:", IDC_CAPTURE_SOUND_LABEL, 7, 48, 36, 8
    COMBOBOX        IDC_CAPTURE_SOUND, 46, 46, 137, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 79, 70, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 133, 70, 50, 14
END
